{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "buildCommand": "npm run build",
      "entrypoint": "api/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/biblioteca/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/biblioteca.html"
      }
    },
    {
      "source": "/obras/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/obras.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
# Banco de dados PostgreSQL (obrigatório — não há mais banco em arquivo).
# Local:    postgresql://postgres:postgres@127.0.0.1:5432/biblioteca_dev
# Produção: use a string de conexão COM POOLER do provedor (Neon, Vercel, Supabase).
DATABASE_URL=
# TLS: ligado por padrão em produção, desligado em desenvolvimento.
# DATABASE_SSL=true

# Banco usado por `npm test`. Os testes criam e derrubam um schema próprio,
# então pode apontar para o mesmo banco de desenvolvimento.
TEST_DATABASE_URL=

NODE_ENV=development
HOST=127.0.0.1
# 0 = o próprio servidor procura a primeira porta livre a partir de 4300
PORT=0
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
JWT_EXPIRES_IN=7d
COOKIE_NAME=biblioteca_token

OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# usuário criado por `npm run seed`
SEED_NAME=Leitor Demo
SEED_EMAIL=demo@biblioteca.local
SEED_PASSWORD=Leitura@2026

# Assistência por IA. Sem AI_API_KEY, /api/ai/* responde 503 de forma controlada
# e o botão aparece desabilitado no frontend — nada quebra.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-latest

# Modelo alternativo usado quando o principal está sobrecarregado.
AI_FALLBACK_MODEL=gemini-flash-lite-latest

# Fonte secundária SÓ de capas, para os livros que a Open Library não ilustra.
# Funciona sem chave, mas a cota por IP é pequena — para uso real, gere uma em
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_ENABLED=true
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_TIMEOUT_MS=4000
